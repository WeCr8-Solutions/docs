  "keyFeatures": [
    "Digital shift handoff forms with CNC/machine-type-specific fields",
    "Work order queue with Kanban, list, and calendar views",
    "Real-time station and machine status monitoring",
    "Multi-team organizational structure with role-based access",
    "Non-conformance report (NCR) and quality tracking",
    "ERP connector with bidirectional sync (JobBoss, Epicor, Plex)",
    "Downtime tracking with reason codes and trend analysis",
    "Bulk Excel upload for work orders",
    "AI planning assistant for scheduling and prioritization",
    "Shop floor TV display (supervisor and operator modes)",
    "Operator check-in/check-out and session tracking",
    "Smart alerts and configurable notification thresholds",
    "Work order routing editor and outside processing manager",
    "QR code-based team invite and onboarding",
    "Windows desktop app (installer and portable)"
  ],
  "publicApiSurface": [
    "POST /functions/v1/erp-sync — trigger ERP sync (full or incremental)",
    "POST /functions/v1/create-checkout — start Stripe subscription checkout",
    "POST /functions/v1/customer-portal — open subscription management portal",
    "POST /functions/v1/check-subscription — verify subscription entitlements",
    "POST /functions/v1/update-seats — manage seat counts on Enterprise plan",
    "POST /functions/v1/process-notifications — dispatch queued notifications",
    "POST /functions/v1/send-email — send transactional emails",
    "POST /functions/v1/ai-planning-assistant — get AI scheduling recommendations",
    "POST /functions/v1/report-issue — submit user-reported issues",
    "POST /functions/v1/verify-station-context-payment — validate station context purchases",
    "Supabase Realtime subscriptions — live station status, work order updates, shift handoffs",
    "ShiftHandoffRecord — structured shift handoff data model",
    "StationInfo — station status and current job data model",
    "AppMachineStatus — live CNC machine metrics data model",
    "ERPWorkOrder — work order data model for ERP integration",
    "ERPOperation — operation/routing data model for ERP integration"
  ]
}
